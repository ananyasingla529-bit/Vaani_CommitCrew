# Vaani Moderation Console Environment Configuration
# Set MOCK_MODE=True to run locally with rich realistic mock data without any external API keys.
MOCK_MODE=True

# Authentication & Access Control
# Set AUTH_DISABLED=True for dev mode to let the frontend connect without bearer tokens.
AUTH_DISABLED=True
MODERATOR_EMAIL=moderator@vaani.org
# Default bcrypt hash for "Password123!"
MODERATOR_PASSWORD_HASH=$2b$12$K1rS2B6EflrQ8s9F4P9L6eWqL5V8oWd4dF6gY7hU8jI9kO0pQ1rS2
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters
FERNET_KEY=replace_with_a_base64_urlsafe_32_byte_key_for_encrypting_bot_tokens

# LLM Provider Configuration (Primary: Google Gemini, Secondary Fallback: Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Call Budget and Rate Limiting
LLM_DAILY_BUDGET=500
RATE_LIMIT_PER_MINUTE=60

# Telegram Bot Credentials
# Set up via @BotFather. IMPORTANT: Disable group privacy mode (/setprivacy -> Disable)
# so the bot can receive all group messages, not just mentions.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_PLACEHOLDER
TELEGRAM_MODERATOR_CHAT_ID=984729182
# Set TELEGRAM_LIVE=True to enable live Telegram polling and instant alerts alongside MOCK_MODE=True
TELEGRAM_LIVE=False

# Discord Application Bot Token (Optional if MOCK_MODE=True)
# Ensure "MESSAGE CONTENT INTENT" is enabled in Discord Developer Portal > Bot > Privileged Gateway Intents.
DISCORD_BOT_TOKEN=OTI4Mzc0NjE1MjQzMTA5Mjgz.EXAMPLE_DISCORD_TOKEN
# Set DISCORD_LIVE=True to connect the live Discord gateway even when MOCK_MODE=True
DISCORD_LIVE=False

# YouTube Data API v3 Key (Optional if MOCK_MODE=True)
# Enable YouTube Data API v3 in Google Cloud Console. For live chat actions, configure OAuth 2.0 in Testing mode.
YOUTUBE_API_KEY=AIzaSyEXAMPLE_KEY_FOR_YOUTUBE_V3
YOUTUBE_OAUTH_TOKEN=ya29.a0AfH6SMA_EXAMPLE_OAUTH_BEARER_TOKEN

# Privacy & Retention
RETENTION_DAYS=30
FRONTEND_ORIGIN=http://localhost:5173

# Server Host and Port
PORT=8000
HOST=0.0.0.0
